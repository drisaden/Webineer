NEXT_PUBLIC_APP_NAME=Webineer
# Production: https://webineer.techraacademy.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local-only demo sign-in when Supabase is not configured. Ignored on Vercel production.
NEXT_PUBLIC_DEMO_MODE=false

# --- Authentication: Supabase Auth ---
# Supabase Dashboard -> Project Settings -> API Keys. The publishable key is safe in the browser,
# but this app only uses it on the server. Never put the secret/service_role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# First user to sign in with this verified email becomes super admin (only while none exists).
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com

# --- Email: SMTP (Namecheap cPanel mailbox), server-side only ---
# cPanel -> Email Accounts -> Connect Devices shows the server. Typically mail.<your-domain>
# with SSL on port 465 (or STARTTLS on 587). TLS is always required.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=
# Must be the mailbox above (or an alias of it), or receivers will reject/spam it.
SMTP_FROM="Webineer <no-reply@example.com>"
# Optional: where replies go.
SMTP_REPLY_TO=
# Supabase -> Authentication -> Hooks -> Send Email (HTTPS):
#   URL https://webineer.techraacademy.com/api/auth/email-hook
# Supabase generates the secret ("v1,whsec_..."); paste it here unchanged.
SUPABASE_AUTH_HOOK_SECRET=

# --- Payments: Flutterwave (server-side only) ---
# Dashboard -> Settings -> API Keys. Use the TEST secret key (FLWSECK_TEST-...) for sandbox;
# switching to the live key (FLWSECK-...) is what makes payments real. Never expose it in NEXT_PUBLIC_*.
FLUTTERWAVE_SECRET_KEY=
# Dashboard -> Settings -> Webhooks: set the URL to
#   https://webineer.techraacademy.com/api/webhooks/flutterwave
# and choose a long random "Secret hash"; put the same value here. Webhooks are rejected without it.
FLUTTERWAVE_SECRET_HASH=

# --- File uploads: Cloudinary (server-side only; optional) ---
# Lets hosts upload images and short preview videos instead of pasting links. Files go straight from
# the browser to Cloudinary using a short-lived signature made on the server; without these variables
# the upload buttons are disabled and pasted https links still work.
# Cloudinary Console -> Settings -> API Keys (Cloud name, API Key, API Secret).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Database: Supabase PostgreSQL via Prisma (server-side only) ---
# Runtime (Vercel): Supavisor pooled connection, transaction mode, port 6543.
# Supabase Dashboard -> Connect -> ORMs / Transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Migrations (prisma migrate deploy/dev): direct or session-mode connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional: Supabase CA certificate (PEM or base64 PEM) for verified TLS.
# Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate.
DATABASE_SSL_CA=
# Optional: connections per serverless instance (default 3).
DATABASE_POOL_MAX=3
# Optional: only for `prisma migrate dev` against a database without CREATE DATABASE rights.
SHADOW_DATABASE_URL=
# Local integration tests only (database name must contain "test"). Never point at production.
TEST_DATABASE_URL=

# Optional host or DNS provider configuration for custom domains
CUSTOM_DOMAIN_PROVIDER= webineer.techraacademy.com

# Webinar workflow
# Bearer token for /api/cron/tick (reminders, follow-ups, replay emails, webinar status,
# payment reconciliation, plan expiry, email retries). Long random value, e.g. openssl rand -hex 32.
# Vercel Cron sends it automatically. For a tick every 5 minutes on any Vercel plan,
# run supabase/cron.sql once in the Supabase SQL editor (pg_cron) with this same value.
CRON_SECRET=
# Required outside demo mode: signs personal registration/room links (HMAC, never stored).
# Generate with: openssl rand -base64 48   (at least 32 characters). Rotating it invalidates existing links.
REGISTRATION_LINK_SECRET=
# Demo mode only — mock repository persistence: "file" (default, writes .webineer-data/) or "memory".
WEBINEER_MOCK_PERSISTENCE=file

