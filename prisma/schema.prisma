// Webineer production schema (Supabase PostgreSQL via Prisma).
//
// Conventions
// - Tables/columns are snake_case in Postgres, camelCase in Prisma.
// - Every tenant-owned table carries `organization_id`. Children of a webinar
//   reference it through the composite key (webinar_id, organization_id), so
//   the database itself rejects rows whose organization differs from their
//   webinar's organization.
// - Prisma connects with a privileged role and bypasses Supabase RLS. Tenant
//   isolation is enforced in the server-side data layer (src/server/db) and
//   RLS is enabled without policies so the Supabase Data API (anon /
//   authenticated keys) cannot read these tables at all.
// - users.id equals the Supabase Auth user id (auth.users.id).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  TECHNICAL_ADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  HOST
  ANALYST
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlanCode {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum CurrencyCode {
  NGN
  USD
  EUR
  GBP
}

enum WebinarStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum WebinarType {
  LIVE
  AUTOMATED
  EVERGREEN
  ON_DEMAND
  RECURRING
}

enum WebinarMode {
  RIGHT_NOW
  SCHEDULE_LATER
  ALWAYS_ON
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  WISTIA
  CUSTOM_IFRAME
  CUSTOM_URL
  UPLOADED_VIDEO
  EXTERNAL_LIVE_STREAM
}

enum SessionStatus {
